<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050505">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="30dp">
        
        <TextView android:text="ADMIN PANEL" android:textColor="#E53935" android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="30dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        
        <EditText android:id="@+id/masterId" android:hint="Admin ID" android:textColor="#FFF" android:textColorHint="#888" android:backgroundTint="#D4AF37" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:layout_marginBottom="15dp" android:inputType="text"/>
        
        <EditText android:id="@+id/masterPass" android:hint="Password" android:textColor="#FFF" android:textColorHint="#888" android:inputType="textPassword" android:backgroundTint="#D4AF37" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:layout_marginBottom="20dp"/>

        <EditText android:id="@+id/creditAmount" android:hint="Credits Amount (e.g. 50)" android:textColor="#FFF" android:textColorHint="#888" android:inputType="number" android:backgroundTint="#4ade80" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:layout_marginBottom="20dp"/>
        
        <Button android:id="@+id/genBtn" android:text="GENERATE KEY WITH CREDITS" android:backgroundTint="#D4AF37" android:textColor="#000" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="15dp"/>
        
        <Button android:id="@+id/addLocalCreditsBtn" android:text="ADD CREDITS TO THIS DEVICE" android:backgroundTint="#4ade80" android:textColor="#000" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="25dp"/>
        
        <TextView android:id="@+id/resultKey" android:text="---" android:textColor="#4ade80" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="#050505" android:padding="30dp">
    <TextView android:text="RAJPUT INFO" android:textColor="#D4AF37" android:textSize="32sp" android:textStyle="bold" android:layout_marginBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Enter License Key" android:textColor="#888" android:layout_marginBottom="30dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/keyInput" android:hint="RAJPUT-PRO-XXXX" android:textColor="#FFF" android:textColorHint="#555" android:backgroundTint="#D4AF37" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:layout_marginBottom="20dp" android:inputType="textCapCharacters"/>
    <Button android:id="@+id/loginBtn" android:text="LOGIN" android:textColor="#000" android:backgroundTint="#D4AF37" android:layout_width="match_parent" android:layout_height="50dp" android:textStyle="bold"/>
</LinearLayout>
